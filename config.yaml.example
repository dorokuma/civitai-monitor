# =============================================================================
# Civitai Monitor — Configuration
# =============================================================================
# Copy this file to config.yaml and replace all placeholders with your
# actual values BEFORE running the script.
#
#   cp config.yaml.example config.yaml
#   # edit config.yaml → fill in YOUR_*
#
# =============================================================================

# ---------------------------------------------------------------------------
# User(s) to monitor
# ---------------------------------------------------------------------------
# List of Civitai usernames whose galleries will be polled for new images.
users:
  - name: "YOUR_TARGET_USERNAME_1"
  # - name: "YOUR_TARGET_USERNAME_2"

# ---------------------------------------------------------------------------
# Operation mode
# ---------------------------------------------------------------------------
#   incremental (default): check only the latest page(s) — ideal for cron
#   full: walk every page of the user's gallery — use for initial backfill
mode: "incremental"

# ---------------------------------------------------------------------------
# NSFW filtering
# ---------------------------------------------------------------------------
#   sfw_only:  only safe-for-work images
#   nsfw_only: only NSFW images
#   both:      pull both SFW and NSFW (recommended — note: API returns SFW
#              by default when no nsfw param is given, so "both" makes two
#              separate API calls per poll)
nsfw: "both"

# ---------------------------------------------------------------------------
# Civitai API settings
# ---------------------------------------------------------------------------
api:
  # Base URL for the Civitai REST API (public, no key required).
  base_url: "https://civitai.com/api/v1"

  # Images to fetch per page.  Max recommended: 100.
  # For incremental mode: lower = faster polls (e.g. 20).
  # For full mode:        higher = fewer pages (e.g. 100).
  images_per_page: 100

# ---------------------------------------------------------------------------
# Download settings
# ---------------------------------------------------------------------------
download:
  # Directory (relative to data_dir) where downloaded originals are cached.
  output_dir: "downloads"

  # URL size-suffixes to replace with "width=original".
  # Civitai CDN returns preview URLs like ".../width=1024/...";
  # the script replaces these to fetch the full-resolution original.
  size_suffixes:
    - "/width=1024/"
    - "/width=450/"
    - "/width=640/"

# ---------------------------------------------------------------------------
# Telegram Bot (required — script will not run without these)
# ---------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram and paste the token here.
# To find your chat/channel ID, forward a message from the destination
# to @userinfobot or look it up in the URL of a public group.
telegram:
  bot_token: "YOUR_TELEGRAM_BOT_TOKEN"
  chat_id: "YOUR_TELEGRAM_CHAT_ID"

# ---------------------------------------------------------------------------
# Data persistence
# ---------------------------------------------------------------------------
data:
  # Directory for seen_ids.json and downloads/.  Defaults to the script's
  # own directory if left empty.
  data_dir: ""

  # File that tracks already-processed image IDs (auto-generated).
  seen_ids_file: "seen_ids.json"
